# Nena runs without any of these (scripted fallback mind). Add ONE provider to give her a model.

# Option A: Anthropic
# ANTHROPIC_API_KEY=
# NENA_MODEL=claude-haiku-4-5

# Option B: any OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama at http://localhost:11434/v1 ...)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# NENA_MODEL=llama3.2

PORT=8787
# Real seconds per Nena day
DAY_SECONDS=3600
# Where her files live
DATA_DIR=./data
